# =============================================================================
# MT5 AI Scalper — Variaveis de ambiente
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA versione o arquivo ".env" (ja esta listado em .gitignore).
# Todos os valores abaixo sao placeholders — substitua antes de usar.
# =============================================================================

# --- Aplicacao -----------------------------------------------------------
APP_NAME="MT5 AI Scalper"
APP_ENV=development          # development | test | staging | production
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
APP_HOST=0.0.0.0
APP_PORT=8000

# Modo do sistema no boot. Deve permanecer DISABLED ate as fases de execucao
# existirem. Nunca defina REAL_ENABLED aqui.
SYSTEM_MODE=DISABLED

# --- Autenticacao / JWT ----------------------------------------------------
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ATENCAO: bypass de desenvolvimento -- NUNCA true em producao. Libera as
# paginas do dashboard sem login, autenticando automaticamente como um
# usuario "dev" (ADMIN, criado sob demanda). Nao afeta /api/* (JWT continua
# exigido). Deixe false/comentado assim que voce resolver login/senha.
DASHBOARD_AUTH_DISABLED=false

# Login Google (OpenID Connect). Cadastre exatamente a mesma URL de callback
# no Google Cloud Console. Deixe vazio para ocultar o botao de login Google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Banco de dados (MySQL 8) ----------------------------------------------
# Preencha com um servidor MySQL 8 real quando disponivel.
# Ate la, a suite de testes usa SQLite em memoria automaticamente.
DB_DRIVER=mysql+pymysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mt5_ai_scalper
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_ECHO=false

# Docker publica o MySQL somente em 127.0.0.1 para o conector MT5 do Windows.
# Altere apenas se a porta 3306 ja estiver em uso no host.
DB_EXPOSED_PORT=3306
DB_ROOT_PASSWORD=CHANGE_ME_root

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=true

# --- MetaTrader 5 (conector somente leitura, Fase 2) ------------------------
# Preencha para coletar dados de um terminal MT5 real (demo ou real) ja
# instalado e autenticado nesta maquina Windows. Sem estes valores, os
# comandos "mt5 check" / "collect candles" / "collect ticks" da CLI falham
# com uma mensagem clara — nada e inventado ou simulado como resposta real
# do terminal.
MT5_TERMINAL_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"
MT5_LOGIN=CHANGE_ME
MT5_PASSWORD=CHANGE_ME
MT5_SERVER=CHANGE_ME
MT5_VNC_PASSWORD=CHANGE_ME_use_a_different_strong_password
# Interface local para concluir login/manual do terminal Wine.
MT5_VNC_PORT=8081
# MT5_BRIDGE_HOST/PORT: configure pelo painel (Configuracoes -> Conexao
# MetaTrader 5). O painel tem precedencia sobre estas variaveis.
MT5_TIMEOUT_MS=10000
MT5_MAX_RECONNECT_ATTEMPTS=5
MT5_RECONNECT_BACKOFF_SECONDS=2.0
MT5_HEARTBEAT_INTERVAL_SECONDS=30.0

# --- Qualidade de dados e retencao (Fase 3) ---------------------------------
QUALITY_MAX_SPREAD_POINTS=50.0
QUALITY_MAX_FEED_DELAY_SECONDS=300
QUALITY_MIN_SCORE=70
TICK_RETENTION_DAYS=30

# --- Machine learning (Fase 8) -----------------------------------------------
ML_DATASETS_DIR=datasets
ML_MODELS_DIR=models

# --- Noticias/fundamentos externos (Fase 18.6) ------------------------------
# Opcional. Sem preencher (aqui ou via /dashboard/settings/aisa), o motor de
# analise (Fase 18) usa um provedor "nao configurado" que contribui neutro no
# score composto -- nunca inventa noticia/sentimento. Preencher a chave AINDA
# NAO ativa um provedor real (nenhum contrato HTTP da API AIsa foi
# documentado/implementado nesta fase) -- ver app/news/factory.py.
AISA_API_KEY=
AISA_API_BASE_URL=

# Cada analise consome DUAS chamadas da MarketPulse (noticias + fundamentos).
# Uma resposta boa e reaproveitada por este prazo, por simbolo, dentro do
# processo -- recarregar a tela de analise ou rodar um ciclo do piloto deixa
# de gerar chamada nova. Somente respostas OK entram no cache (falha nunca e
# congelada) e a resposta reaproveitada informa a propria idade na tela.
# 0 desliga o cache.
NEWS_CACHE_TTL_SECONDS=600

# Teto DURO de chamadas por dia UTC, compartilhado entre o servidor web e o
# conector Windows (contado no banco, nao em memoria). O cache evita
# repeticao; isto evita surpresa no fim do mes. Ao atingir o limite,
# noticias/fundamentos SAEM do calculo em vez de gastar mais -- nunca viram
# dado inventado. 0 = sem limite.
NEWS_DAILY_CALL_BUDGET=300

# --- Calendario economico ----------------------------------------------------
# Filtro "nao entre em cima de evento de alto impacto". Vazio desliga.
# Aponta para um JSON mantido por fora do processo -- tipicamente exportado do
# calendario NATIVO do MetaTrader 5 por um EA: fonte gratuita, sem terceiro,
# sem cota. Ver docs/calendar.md.
CALENDAR_FILE_PATH=
CALENDAR_BLACKOUT_BEFORE_MINUTES=30
# O perigo nao acaba na divulgacao: depois dela o spread abre e o preco
# chicoteia.
CALENDAR_BLACKOUT_AFTER_MINUTES=15
CALENDAR_MIN_IMPACT=HIGH
CALENDAR_CACHE_TTL_SECONDS=900
# Acima disso o arquivo e considerado desatualizado. Calendario velho e pior
# que nenhum: os eventos de hoje nao estao la.
CALENDAR_MAX_AGE_HOURS=36
# Sem calendario, o robo CONTINUA operando (decisao explicita). A ausencia
# aparece no status e no relatorio do dia. `true` inverte para o lado
# paranoico.
CALENDAR_BLOCK_WHEN_UNAVAILABLE=false

# --- Corretora de execucao ---------------------------------------------------
# `mt5` (padrao) e o unico caminho hoje validado contra conta real.
# `ctrader` liga o adaptador da Open API (JSON/TCP, porta 5036) -- a camada de
# traducao tem teste, mas o transporte so pode ser validado com conta real.
# Ver docs/broker.md. Faltando credencial, o sistema FALHA -- nunca volta ao
# MT5 em silencio.
BROKER=mt5
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=
# Usado quando a Open API nao informa `isLive`. Sem isso o sistema recusa
# operar em vez de adivinhar se o dinheiro e de verdade.
CTRADER_ACCOUNT_IS_DEMO=true

# --- Motor de analise Price Action / SMC / multi-timeframe (Fase 18) --------
ANALYSIS_DEFAULT_TIMEFRAME=M15
ANALYSIS_DEFAULT_THRESHOLD=90.0

# --- Jev / TypeSafe: classificacao VISUAL do Pulso ---------------------------
# Camada OPCIONAL e desligada por padrao. Recebe um resumo tecnico ja
# calculado e devolve UM rotulo entre quatro (STRONG_SETUP, CAUTION, WAIT,
# INSUFFICIENT_DATA) mais um aviso de "conferir antes de agir".
#
# O que ela NAO faz: nao gera preco, zona, entrada, stop, alvo, direcao nem
# ordem. Todos esses valores continuam vindo exclusivamente do motor tecnico
# local. Desligar o Jev nao muda numero nenhum no grafico -- so tira um
# rotulo colorido da legenda.
#
# Desligado, indisponivel, lento ou com resposta invalida, o Pulso responde
# igual e marca signal_ai.available=false. Nunca bloqueia e nunca executa
# nada por causa disso. Ver docs/indicador-mt5.md.
JEV_ENABLED=false

# Lida SOMENTE daqui. Nao existe campo equivalente em system_settings nem no
# painel, de proposito: segredo guardado no banco ganha um segundo lugar de
# onde vazar (backup, dump, tela de configuracao). Nao reaproveite
# AISA_API_KEY -- sao servicos distintos, e chave compartilhada faz o
# vazamento de um virar o vazamento dos dois.
JEV_API_KEY=

JEV_API_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Curto de proposito: este passo e acessorio e nao pode atrasar o desenho do
# grafico. Estourado o prazo, o Pulso responde sem a classificacao.
JEV_TIMEOUT_SECONDS=2.5

# Teto de idade da classificacao. Quem decide reavaliar de fato e a candle:
# enquanto a candle e o resumo tecnico nao mudam, a resposta e reaproveitada
# e NENHUMA chamada nova e feita -- o indicador consulta a cada 15s, e uma
# chamada por consulta seria desperdicio. Este prazo so impede que uma candle
# longa (H4, D1) congele o veredito por horas. 0 desliga o cache.
JEV_CACHE_TTL_SECONDS=300

# Executa migrations + preflight antes de iniciar o servidor no Docker.
# Mantenha true; use false apenas em diagnosticos controlados.
RUN_PREFLIGHT=true

# =============================================================================
# Alertas (email/Telegram/etc.) ainda NAO existem neste projeto. Drift de
# modelo e saude do feed (Fase 13) sao detectados e persistidos em
# "drift_events" e visiveis em /dashboard/drift e "python -m app.cli monitor
# model/feed" — nao ha, por enquanto, notificacao por um canal externo.
# Antes de operar por um periodo estendido, rode "python -m app.cli
# preflight check" (Fase 15) para validar este arquivo (.env) de ponta a
# ponta: segredo de aplicacao, banco/migrations, diretorios de artefato e
# credenciais MT5.
# =============================================================================

# --- MetaTrader sob Wine (mt5-wine em Docker) ---------------------------
# Preenchido, o painel Linux fala com o terminal direto e o worker Windows
# deixa de ser necessario. Vazio, mantem o comportamento antigo.
# ATENCAO: a ponte RPyC permite executar codigo do outro lado. Publique a
# porta SOMENTE na rede interna do Docker, nunca na internet.
# Rede Docker onde vive o container do MetaTrader. Preenchida, o painel
# passa a enxergar o terminal por nome a cada deploy, sem `docker network
# connect` manual (que se perde quando o container `app` e recriado).
# Descubra com `docker network ls`. Ex.: metatrader-5-9p2b_default
MT5_NETWORK=

MT5_BRIDGE_HOST=
MT5_BRIDGE_PORT=18812

# Chave dedicada para cifrar credenciais no banco (app/core/crypto.py).
# Vazia, o APP_SECRET_KEY e usado. Trocar qualquer uma invalida o cifrado.
CREDENTIALS_ENCRYPTION_KEY=
